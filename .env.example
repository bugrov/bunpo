# Скопируйте в .env и заполните. Файл .env в git не попадает.
# Строка подключения Neon (pooled) для приложения.
NUXT_DATABASE_URL=
# Прямая строка подключения Neon (unpooled) для миграций drizzle-kit.
DATABASE_URL_UNPOOLED=
# Секрет для шифрования сессий (nuxt-auth-utils >= 0.6). Например: openssl rand -base64 32
NUXT_APP_SECRET=
